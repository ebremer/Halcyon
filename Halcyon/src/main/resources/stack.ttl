@prefix zeph: <https://halcyon.is/zephyr/ns/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
<stack/1> a zeph:Stack ;
    zeph:layers (
        [ zeph:src <Stack0.tif> ]
        [ zeph:src <Stack1.tif> ]
        [ zeph:src <Stack2.tif> ]
        [ zeph:src <Stack3.tif> ]
        [ zeph:src <Stack4.tif> ]
        [ zeph:src <Stack5.tif> ]
    ) .

