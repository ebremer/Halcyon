        [ zeph:src <Stack3.tif> ]
        [ zeph:src <Stack4.tif> ]
        [ zeph:src <Stack5.tif> ]
        [ zeph:src <Stack6.tif> ]
    ) .

<Stack0.tif> exif:width 10220; exif:height 8570 .
